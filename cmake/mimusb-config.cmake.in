@PACKAGE_INIT@

set(mimusb_VERSION "@PROJECT_VERSION@")
set(mimusb_HOMEPAGE_URL "@PROJECT_HOMEPAGE_URL@")
set(mimusb_FOUND TRUE)

set(mimusb_shared_FOUND FALSE)
set(mimusb_static_FOUND FALSE)
set(_MIMUSB_REQUEST_SHARED FALSE)
set(_MIMUSB_REQUEST_STATIC FALSE)
set(_MIMUSB_DEFAULT_STATIC FALSE)
set(_MIMUSB_HAS_SHARED FALSE)
set(_MIMUSB_HAS_STATIC FALSE)
# Require both the configure-time contract and the installed export file.
set(_MIMUSB_BUILT_SHARED @MIMUSB_BUILD_SHARED@)
set(_MIMUSB_BUILT_STATIC @MIMUSB_BUILD_STATIC@)
if(_MIMUSB_BUILT_SHARED AND EXISTS "${CMAKE_CURRENT_LIST_DIR}/mimusb-shared-targets.cmake")
  set(_MIMUSB_HAS_SHARED TRUE)
endif()
if(_MIMUSB_BUILT_STATIC AND EXISTS "${CMAKE_CURRENT_LIST_DIR}/mimusb-static-targets.cmake")
  set(_MIMUSB_HAS_STATIC TRUE)
endif()

if(mimusb_FIND_COMPONENTS)
  foreach(_MIMUSB_COMPONENT IN LISTS mimusb_FIND_COMPONENTS)
    if(_MIMUSB_COMPONENT STREQUAL "shared")
      set(_MIMUSB_REQUEST_SHARED TRUE)
    elseif(_MIMUSB_COMPONENT STREQUAL "static")
      set(_MIMUSB_REQUEST_STATIC TRUE)
    else()
      set("mimusb_${_MIMUSB_COMPONENT}_FOUND" FALSE)
    endif()
  endforeach()
elseif(_MIMUSB_HAS_SHARED)
  set(_MIMUSB_REQUEST_SHARED TRUE)
else()
  set(_MIMUSB_REQUEST_STATIC TRUE)
  set(_MIMUSB_DEFAULT_STATIC TRUE)
endif()

if(_MIMUSB_REQUEST_SHARED AND _MIMUSB_HAS_SHARED)
  include("${CMAKE_CURRENT_LIST_DIR}/mimusb-shared-targets.cmake")
  set(mimusb_shared_FOUND TRUE)
endif()
if(_MIMUSB_REQUEST_STATIC AND _MIMUSB_HAS_STATIC)
  include("${CMAKE_CURRENT_LIST_DIR}/mimusb-static-targets.cmake")
  set(mimusb_static_FOUND TRUE)
  if(NOT TARGET mimusb::mimusb AND TARGET mimusb::mimusb_static)
    add_library(mimusb::mimusb ALIAS mimusb::mimusb_static)
  endif()
endif()

if(_MIMUSB_DEFAULT_STATIC AND NOT mimusb_static_FOUND)
  set(mimusb_FOUND FALSE)
endif()

check_required_components(mimusb)

unset(_MIMUSB_COMPONENT)
unset(_MIMUSB_REQUEST_SHARED)
unset(_MIMUSB_REQUEST_STATIC)
unset(_MIMUSB_DEFAULT_STATIC)
unset(_MIMUSB_HAS_SHARED)
unset(_MIMUSB_HAS_STATIC)
unset(_MIMUSB_BUILT_SHARED)
unset(_MIMUSB_BUILT_STATIC)
