@PACKAGE_INIT@

set(mimhid_VERSION "@PROJECT_VERSION@")
set(mimhid_HOMEPAGE_URL "@PROJECT_HOMEPAGE_URL@")
set(mimhid_FOUND TRUE)

set(mimhid_shared_FOUND FALSE)
set(mimhid_static_FOUND FALSE)
set(_MIMHID_REQUEST_SHARED FALSE)
set(_MIMHID_REQUEST_STATIC FALSE)
set(_MIMHID_DEFAULT_STATIC FALSE)
set(_MIMHID_HAS_SHARED FALSE)
set(_MIMHID_HAS_STATIC FALSE)
# Require both the configure-time contract and the installed export file.
set(_MIMHID_BUILT_SHARED @MIMHID_BUILD_SHARED@)
set(_MIMHID_BUILT_STATIC @MIMHID_BUILD_STATIC@)
if(_MIMHID_BUILT_SHARED AND EXISTS "${CMAKE_CURRENT_LIST_DIR}/mimhid-shared-targets.cmake")
  set(_MIMHID_HAS_SHARED TRUE)
endif()
if(_MIMHID_BUILT_STATIC AND EXISTS "${CMAKE_CURRENT_LIST_DIR}/mimhid-static-targets.cmake")
  set(_MIMHID_HAS_STATIC TRUE)
endif()

if(mimhid_FIND_COMPONENTS)
  foreach(_MIMHID_COMPONENT IN LISTS mimhid_FIND_COMPONENTS)
    if(_MIMHID_COMPONENT STREQUAL "shared")
      set(_MIMHID_REQUEST_SHARED TRUE)
    elseif(_MIMHID_COMPONENT STREQUAL "static")
      set(_MIMHID_REQUEST_STATIC TRUE)
    else()
      set("mimhid_${_MIMHID_COMPONENT}_FOUND" FALSE)
    endif()
  endforeach()
elseif(_MIMHID_HAS_SHARED)
  set(_MIMHID_REQUEST_SHARED TRUE)
else()
  set(_MIMHID_REQUEST_STATIC TRUE)
  set(_MIMHID_DEFAULT_STATIC TRUE)
endif()

if(_MIMHID_REQUEST_SHARED AND _MIMHID_HAS_SHARED)
  include("${CMAKE_CURRENT_LIST_DIR}/mimhid-shared-targets.cmake")
  set(mimhid_shared_FOUND TRUE)
endif()
if(_MIMHID_REQUEST_STATIC AND _MIMHID_HAS_STATIC)
  include("${CMAKE_CURRENT_LIST_DIR}/mimhid-static-targets.cmake")
  set(mimhid_static_FOUND TRUE)
  if(NOT TARGET mimhid::mimhid AND TARGET mimhid::mimhid_static)
    add_library(mimhid::mimhid ALIAS mimhid::mimhid_static)
  endif()
endif()

if(_MIMHID_DEFAULT_STATIC AND NOT mimhid_static_FOUND)
  set(mimhid_FOUND FALSE)
endif()

check_required_components(mimhid)

unset(_MIMHID_COMPONENT)
unset(_MIMHID_REQUEST_SHARED)
unset(_MIMHID_REQUEST_STATIC)
unset(_MIMHID_DEFAULT_STATIC)
unset(_MIMHID_HAS_SHARED)
unset(_MIMHID_HAS_STATIC)
unset(_MIMHID_BUILT_SHARED)
unset(_MIMHID_BUILT_STATIC)
